<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to even launch ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (MainActivity) —
         without it the OS throws SecurityException, which is exactly what left a real device
         stuck on that screen (found by on-device testing, not any test suite). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".OrtApplication"
        android:allowBackup="false"
        android:label="Offline Radio Transcriber">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Compose navigation host (build-plan P13, D15): theme, drawer and nav graph, with
             capture status and the transmission list as Compose screens (`StatusScreen`,
             `TransmissionListScreen`). This is now the app's reader — `MainActivity` launches it
             directly after starting capture. The v0 plain-`TextView` `StatusActivity` and
             `TransmissionListActivity` that originally carried these facts (build-plan P8/P11)
             are deleted (audit F-002): nothing launched them once this nav host took over, and
             `StatusActivity` carried the second copy of the fabricated-shed-signal bug fixed
             here. -->
        <activity android:name=".ui.ReaderActivity" android:exported="false" />
    </application>
</manifest>

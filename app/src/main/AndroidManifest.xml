<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to even launch ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (MainActivity) —
         without it the OS throws SecurityException, which is exactly what left a real device
         stuck on that screen (found by on-device testing, not any test suite). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".OrtApplication"
        android:allowBackup="false"
        android:label="Offline Radio Transcriber">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The capture status surface (build-plan P8, FR-UI-7). Not yet the app's launcher —
             MainActivity remains the entry point until the reader UI/navigation host lands. -->
        <activity android:name=".status.StatusActivity" android:exported="false" />

        <!-- The minimal transmission-list reader surface (build-plan P11, FR-A11Y-1) — the first
             point an attribution reaches a screen. A full reader (live view, threads, playback,
             correction) is M5; not yet the app's launcher for the same reason as StatusActivity. -->
        <activity android:name=".transmissions.TransmissionListActivity" android:exported="false" />
    </application>
</manifest>

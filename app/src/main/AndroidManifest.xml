<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to even launch ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (MainActivity) —
         without it the OS throws SecurityException, which is exactly what left a real device
         stuck on that screen (found by on-device testing, not any test suite). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- D33/D34, FR-RIG-14, S02c (`Setup-Bluetooth-Permission.dc.html`) — Bluetooth capture mode's
         "Nearby devices" ask: read the paired-device list and open a serial link to the chosen
         rig. `BLUETOOTH_CONNECT` is the dangerous, runtime-requested permission from API 31; below
         that, the normal-protection legacy `BLUETOOTH` permission (granted at install, never
         prompted) covers the same RFCOMM socket operations, so it is declared with
         `maxSdkVersion` rather than left to imply a runtime prompt that platform level never
         shows. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <!-- R-1005a (device field report): `BLUETOOTH_SCAN` was never declared, so
         `RigLinkPort.pairedDevices()` could read `SecurityException`-adjacent empty results on a
         real API 31+ device the moment the platform's own paired-device query touches scanning —
         S10b's own `PermissionsState.bluetoothConnectGranted` check only ever asked about
         `BLUETOOTH_CONNECT`. `neverForLocation` is correct here (not merely convenient): this app
         only ever scans for its own already-paired SPP rig, never derives a location from a scan
         result, and constitution V already forbids collecting anything finer than a grid square —
         asking for `ACCESS_FINE_LOCATION` on top of this permission would be exactly that, for a
         capability this app has no use for. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- P22 (D43, FR-AST-10..12, AC-184): the setup MODELS step's model download runs as a
         foreground WorkManager job (org.ort.app.work.ModelDownloadWorker), which needs
         FOREGROUND_SERVICE unconditionally and, from API 34, the specific service-type permission
         matching the ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC that class declares. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- R-1106 (register; technical-design §12.4, NFR-6a, FR-PLT-5, FR-STO-8): allowBackup alone
         already refuses cloud backup and device-to-device transfer, but the technical design calls
         for an explicit data_extraction_rules exclusion too, declared where API 31+'s own
         backup/transfer framework reads it rather than left implicit — see that resource's own
         comment for the full reasoning and what it deliberately excludes (everything). -->
    <application
        android:name=".OrtApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Offline Radio Transcriber"
        android:theme="@style/Theme.Ort">
        <!-- R-001/R-006 (ui-conformance-plan WP1): `Theme.Ort` (res/values/themes.xml) replaces the
             platform `Theme.DeviceDefault` every Activity rendered under before this attribute
             existed — that default theme carries an ActionBar, which is what R-001 found: a
             platform header above the Compose one on every screen. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The guided setup sequence (build-plan P8, ui-conformance-plan WP9, register
             R-080..R-084, `Flow-Setup.dc.html`) — MainActivity routes here whenever setup is
             incomplete or a capture-gating permission has been revoked since it last completed;
             SetupActivity hands back to MainActivity once `Start capture` is tapped on S12. Not
             exported: only MainActivity ever launches it. -->
        <activity android:name=".ui.setup.SetupActivity" android:exported="false" />

        <!-- The Compose navigation host (build-plan P13, D15): theme, drawer and nav graph, with
             capture status and the transmission list as Compose screens (`StatusScreen`,
             `TransmissionListScreen`). This is now the app's reader — `MainActivity` launches it
             directly after starting capture. The v0 plain-`TextView` `StatusActivity` and
             `TransmissionListActivity` that originally carried these facts (build-plan P8/P11)
             are deleted (audit F-002): nothing launched them once this nav host took over, and
             `StatusActivity` carried the second copy of the fabricated-shed-signal bug fixed
             here. -->
        <activity android:name=".ui.ReaderActivity" android:exported="false" />

        <!-- P22 (D43, FR-AST-10..12, AC-184): declares the foreground-service type for
             WorkManager's own SystemForegroundService, which org.ort.app.work.ModelDownloadWorker
             calls into via CoroutineWorker.setForeground, required from API 34 (Android 14),
             which refuses an undeclared foreground-service type at startForeground() time. `merge`
             combines with whatever type another WorkManager-using module's own manifest already
             contributes, rather than one overwriting the other. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- P30 (FR-EXP-7): the share sheet's own FileProvider — ACTION_SEND needs a content://
             Uri, never a file:// one (Android refuses the latter across app boundaries from API
             24 on). Not exported: only this app's own share-sheet code (SettingsContent.kt) ever
             resolves a Uri through it, and grantUriPermissions is what lets the *receiving* app
             (whatever the operator picks in the chooser) read that one file without a broader
             grant. `${applicationId}` resolves to org.ort.app for both build flavors (neither
             applies an id suffix). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to even launch ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (MainActivity) —
         without it the OS throws SecurityException, which is exactly what left a real device
         stuck on that screen (found by on-device testing, not any test suite). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- D33/D34, FR-RIG-14, S02c (`Setup-Bluetooth-Permission.dc.html`) — Bluetooth capture mode's
         "Nearby devices" ask: read the paired-device list and open a serial link to the chosen
         rig. `BLUETOOTH_CONNECT` is the dangerous, runtime-requested permission from API 31; below
         that, the normal-protection legacy `BLUETOOTH` permission (granted at install, never
         prompted) covers the same RFCOMM socket operations, so it is declared with
         `maxSdkVersion` rather than left to imply a runtime prompt that platform level never
         shows. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <application
        android:name=".OrtApplication"
        android:allowBackup="false"
        android:label="Offline Radio Transcriber"
        android:theme="@style/Theme.Ort">
        <!-- R-001/R-006 (ui-conformance-plan WP1): `Theme.Ort` (res/values/themes.xml) replaces the
             platform `Theme.DeviceDefault` every Activity rendered under before this attribute
             existed — that default theme carries an ActionBar, which is what R-001 found: a
             platform header above the Compose one on every screen. -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The guided setup sequence (build-plan P8, ui-conformance-plan WP9, register
             R-080..R-084, `Flow-Setup.dc.html`) — MainActivity routes here whenever setup is
             incomplete or a capture-gating permission has been revoked since it last completed;
             SetupActivity hands back to MainActivity once `Start capture` is tapped on S12. Not
             exported: only MainActivity ever launches it. -->
        <activity android:name=".ui.setup.SetupActivity" android:exported="false" />

        <!-- The Compose navigation host (build-plan P13, D15): theme, drawer and nav graph, with
             capture status and the transmission list as Compose screens (`StatusScreen`,
             `TransmissionListScreen`). This is now the app's reader — `MainActivity` launches it
             directly after starting capture. The v0 plain-`TextView` `StatusActivity` and
             `TransmissionListActivity` that originally carried these facts (build-plan P8/P11)
             are deleted (audit F-002): nothing launched them once this nav host took over, and
             `StatusActivity` carried the second copy of the fabricated-shed-signal bug fixed
             here. -->
        <activity android:name=".ui.ReaderActivity" android:exported="false" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".OrtApplication"
        android:allowBackup="false"
        android:label="Offline Radio Transcriber">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The capture status surface (build-plan P8, FR-UI-7). Not yet the app's launcher —
             MainActivity remains the entry point until the reader UI/navigation host lands. -->
        <activity android:name=".status.StatusActivity" android:exported="false" />
    </application>
</manifest>
